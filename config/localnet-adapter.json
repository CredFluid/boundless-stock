{
  "name": "crossstock-adapter",
  "_comment": "ADAPT MODE. The tokenized stock ALREADY EXISTS on the home chain, so the infra locks it in an OmniTokenAdapter instead of minting a new one. Diff against localnet.json: the only change is token.existingToken. Holders keep their balances and the token's address never changes. Deploy the pre-existing token first with `npm run deploy:legacy`.",
  "token": {
    "name": "Tokenized Apple Inc.",
    "symbol": "tAAPL",
    "decimals": 18,
    "initialSupply": "1000000",
    "existingToken": "${EXISTING_STOCK_ADDRESS}"
  },
  "quoteAsset": {
    "name": "USD Coin",
    "symbol": "USDC",
    "decimals": 6,
    "initialSupply": "50000000"
  },
  "homeChain": {
    "key": "base-sepolia",
    "name": "Base Sepolia",
    "chainId": 84532,
    "eid": 40245,
    "rpcUrl": "http://127.0.0.1:8545",
    "nativeSymbol": "ETH",
    "uniswap": {
      "deployIfMissing": true
    }
  },
  "mirrorChains": [
    {
      "key": "arbitrum-sepolia",
      "name": "Arbitrum Sepolia",
      "chainId": 421614,
      "eid": 40231,
      "rpcUrl": "http://127.0.0.1:8546",
      "nativeSymbol": "ETH"
    },
    {
      "key": "optimism-sepolia",
      "name": "Optimism Sepolia",
      "chainId": 11155420,
      "eid": 40232,
      "rpcUrl": "http://127.0.0.1:8547",
      "nativeSymbol": "ETH"
    }
  ],
  "pool": {
    "feeTier": 3000,
    "initialPrice": "150",
    "baseLiquidity": "100000",
    "quoteLiquidity": "15000000",
    "tickHalfWidth": 60000
  },
  "relay": {
    "homeLzReceiveGas": 300000,
    "homeComposeGas": 1200000,
    "homeComposeValue": "0.01",
    "returnGas": 300000,
    "relayNativeBuffer": "1",
    "returnComposeGas": 400000
  },
  "localMessageLibFee": "0.0001"
}
